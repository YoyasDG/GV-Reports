# Copia este archivo como .env y ajusta los valores.

# Puerto e interfaz donde escucha el servidor
PORT=3000
HOST=0.0.0.0

# Administrador inicial (solo se usa si todavía no existe ninguno)
ADMIN_USER=sistemas
ADMIN_PASSWORD=cambia-esta-contraseña
ADMIN_NAME=Sistemas

# Carpeta de datos (base de datos y fotos). Respáldala.
DATA_DIR=data

# Pon 1 si sirves Reports con HTTPS
COOKIE_SECURE=0

# Zona horaria del servidor
TZ=America/Mexico_City
